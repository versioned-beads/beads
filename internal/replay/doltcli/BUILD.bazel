load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "doltcli",
    srcs = [
        "doltcli.go",
        "procalive_unix.go",
        "procalive_windows.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/replay/doltcli",
    visibility = ["//:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "doltcli_test",
    srcs = [
        "b2_test.go",
        "doltcli_test.go",
        "pcsv_test.go",
    ],
    embed = [":doltcli"],
    deps = ["//internal/replay/replaytest"],
)

# --- begin go_srcs (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
)

# --- end go_srcs ---

