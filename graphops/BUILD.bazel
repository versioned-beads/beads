load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "graphops",
    srcs = [
        "doc.go",
        "errors.go",
        "identity.go",
        "laws.go",
        "reader.go",
        "types.go",
        "types_role.go",
    ],
    importpath = "github.com/steveyegge/beads/graphops",
    visibility = ["//visibility:public"],
    deps = ["//beadserrors"],
)

# Package-shape tests parse source, which must be available in sandbox runfiles.
go_test(
    name = "graphops_test",
    srcs = [
        "laws_internal_test.go",
        "laws_test.go",
        "roles_test.go",
        "types_test.go",
    ],
    data = [":go_srcs"],
    embed = [":graphops"],
    deps = ["//beadserrors"],
)

# --- begin go_srcs (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
)

# --- end go_srcs ---

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
